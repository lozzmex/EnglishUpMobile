<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EnglishUpMobile.Views.LoginPage"
    BackgroundColor="#F4F7FF"
    Title="EnglishUp Mobile">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,65,30,30"
            Spacing="20">

            <!-- Logotipo -->
            <Border
                BackgroundColor="#3155D9"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 25"
                WidthRequest="85"
                HeightRequest="85"
                HorizontalOptions="Center">

                <Label
                    Text="EU"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Border>

            <!-- Bienvenida -->
            <Label
                Text="EnglishUp"
                FontSize="36"
                FontAttributes="Bold"
                TextColor="#172554"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Aprende inglés a tu ritmo"
                FontSize="16"
                TextColor="#64748B"
                HorizontalTextAlignment="Center" />

            <!-- Formulario -->
            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 24"
                Padding="22"
                Margin="0,20,0,0">

                <VerticalStackLayout Spacing="18">

                    <Label
                        Text="¡Bienvenido!"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="#172554" />

                    <Label
                        Text="Inicia sesión para continuar"
                        FontSize="14"
                        TextColor="#64748B" />

                    <!-- Correo -->
                    <Label
                        Text="Correo electrónico"
                        FontAttributes="Bold"
                        TextColor="#334155" />

                    <Entry
                        Placeholder="ejemplo@correo.com"
                        Keyboard="Email"
                        BackgroundColor="#F1F5F9"
                        HeightRequest="50" />

                    <!-- Contraseña -->
                    <Label
                        Text="Contraseña"
                        FontAttributes="Bold"
                        TextColor="#334155" />

                    <Entry
                        Placeholder="Ingresa tu contraseña"
                        IsPassword="True"
                        BackgroundColor="#F1F5F9"
                        HeightRequest="50" />

                    <!-- Botón -->
                    <Button
                        Text="INICIAR SESIÓN"
                        BackgroundColor="#3155D9"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="15"
                        Clicked="IniciarSesion_Clicked" />

                    <Label
                        Text="¿No tienes cuenta? Regístrate"
                        FontSize="14"
                        TextColor="#3155D9"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="EnglishUp Mobile • Proyecto educativo"
                FontSize="12"
                TextColor="#94A3B8"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
